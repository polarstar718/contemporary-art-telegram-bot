      "Gallery Hyundai (서울)"
    ],
    "sources": [
      "Nam June Paik Art Center (백남준아트센터)",
      "National Museum of Modern and Contemporary Art, Korea (MMCA)",
      "Smithsonian American Art Museum",
      "Tate Modern Collection"
    ],
    "artworks": [
