# [필수] 텔레그램 BotFather에서 발급받은 봇 토큰 (예: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# [선택] 알림을 받을 본인의 텔레그램 Chat ID (숫자)
# 미입력 시에도 봇에게 텔레그램에서 /start 를 누르면 자동으로 해당 채팅방이 등록됩니다.
TELEGRAM_CHAT_ID=

# 정기 발송 시각 설정 (기본값: 한국 시간 평일 오전 8시 00분)
DELIVERY_HOUR=8
DELIVERY_MINUTE=0
TIMEZONE=Asia/Seoul

# [선택] Gemini API Key (새로운 현대 미술가 자동 발굴 및 AI 정보 확장용)
GEMINI_API_KEY=
